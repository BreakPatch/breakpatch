# /etc/systemd/system/breakpatch-suite@.timer
#
# When a suite runs. `breakpatch-ci service --suite smoke-7f3a` enables
# breakpatch-suite@smoke-7f3a.timer, which starts breakpatch-suite@smoke-7f3a.service on this schedule.
# With --schedule, it also writes the suite's own schedule to
# breakpatch-suite@<suite>.timer.d/override.conf, as `sudo systemctl edit` would:
#   [Timer]
#   OnCalendar=
#   OnCalendar=*-*-* 02:30
# (the empty line clears the default). `systemctl list-timers 'breakpatch-suite*'` shows the next runs.
# The schedule set on the suite in the app isn't used: this timer is the schedule.
[Unit]
Description=Breakpatch suite %i on a schedule

[Timer]
OnCalendar=Mon..Fri 06:00
# Run a missed one after the machine was off, and don't start every suite in the same second.
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
