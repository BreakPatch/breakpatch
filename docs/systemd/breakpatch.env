# /etc/breakpatch/breakpatch.env: what breakpatch-suite@.service needs that isn't secret.
# (The licence key, the CI account's password and saved secrets are credentials: see the unit.)
BREAKPATCH_CI_EMAIL=ci@yourcompany.com
BREAKPATCH_WORKSPACE_FILE=/etc/breakpatch/team.bpworkspace
BREAKPATCH_MACHINE_ID=pi-runner-1
BREAKPATCH_SUITE_OPTIONS=--version released --secret STAGING_PASSWORD=https://staging.acme.com
