# breakpatch.env: what breakpatch-suite@.service needs that isn't secret. `breakpatch-ci service`
# writes the BREAKPATCH_ lines; other lines (BP_TIMINGS_SCALE=2, say) are kept.
BREAKPATCH_CI_EMAIL="ci@yourcompany.com"
BREAKPATCH_WORKSPACE_FILE="/etc/breakpatch/team.bpworkspace"
BREAKPATCH_MACHINE_ID="pi-runner-1"
