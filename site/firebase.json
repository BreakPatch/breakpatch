{
  "hosting": {
    "site": "breakpatch-web",
    "public": ".",
    "cleanUrls": true,
    "ignore": ["firebase.json", ".firebaserc", "README.md", "build-manual.mjs", "*.test.mjs", "*.py", "**/.*", "package.json", "package-lock.json", "node_modules/**"],
    "headers": [
      {
        "source": "/@(install|install-ci|install-ci.ps1)",
        "headers": [
          { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Cache-Control", "value": "public, max-age=300" }
        ]
      },
      {
        "source": "/assets/**/*.@(webp|png|svg|ico)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      },
      {
        "source": "/assets/*.@(css|js)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  }
}
